# build output
dist/

# generated resume-typst artifacts, all rebuilt by pnpm build:
#   wasm    -> built locally (pnpm build:typst-wasm), published once to R2
#              (pnpm upload:typst-wasm), downloaded at build time. The bridge
#              source lives in crates/resume-typst-wasm/browser.js and is copied
#              in, since wasm-pack owns this output directory.
#   font    -> full font downloaded from Google Fonts, subset regenerated
#   preview -> SVGs regenerated
public/resume-typst-wasm/
public/resume-typst-preview/
public/resume-typst/fonts/NotoSansCJKsc-Regular.otf
public/resume-typst/fonts/NotoSansCJKsc-ResumeSubset.ttf

# generated types
.astro/
.playwright-cli/

# dependencies
node_modules/
crates/**/target/
.pnpm-store/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Photo Inbox
photos-inbox/

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Cloudflare Wrangler
.wrangler/

# Agent (Python Backend)
agent/data/
agent/.venv/
agent/__pycache__/
agent/**/__pycache__/
agent/*.pyc
agent/.pytest_cache/
