---
import { getCollection } from "astro:content";
import Link from "@components/Link.astro";
import GitHubActivity from "@components/GitHubActivity.astro";
import { formatDate } from "@utils/dateUtils";
import { getCachedGitHubActivity } from "@utils/githubActivity";

// Get the latest now entry
const nowEntries = await getCollection("now");
const latestEntry = nowEntries.sort(
  (a, b) => new Date(b.data.lastUpdated).getTime() - new Date(a.data.lastUpdated).getTime()
)[0];

const { summary, lastUpdated } = latestEntry.data;
const githubActivity = await getCachedGitHubActivity({
  runtime: Astro.locals.runtime,
  timeoutMs: 2500,
});
---

<section class="current-status mb-8 border-l-2 border-[color:var(--color-border)] py-3 pl-4">
  <p class="mb-2 text-base leading-relaxed">
    <span class="text-text-primary font-medium">Currently:</span>
    <span class="text-text-secondary ml-1">{summary}</span>
  </p>
  <p class="text-text-tertiary mb-2 text-sm leading-normal">
    Last updated {formatDate(lastUpdated)}
  </p>
  <GitHubActivity variant="compact" activity={githubActivity} />
  <p class="text-text-tertiary text-sm leading-normal">
    <Link href="/now" class="text-sm"> → Learn more about what I'm up to now </Link>
  </p>
</section>
