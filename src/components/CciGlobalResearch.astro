---
import coverage from "../../docs/data/cci-global-evidence-matrix.json";
import boundaries from "../../docs/data/cci-ucdb-efua-crosswalk.json";
import wup from "../../docs/data/cci-wup-2025-crosswalk.json";
import institutions from "../../docs/data/cci-openalex-institution-source.json";
import works from "../../docs/data/cci-openalex-filter-inventory.json";
import authorships from "../../docs/data/cci-openalex-authorship-inventory.json";
import affiliations from "../../docs/data/cci-openalex-global-affiliation-audit.json";
import airports from "../../docs/data/cci-ourairports-fua-audit.json";
import currentViolence from "../../docs/data/cci-ucdp-candidate-2026.json";
import clinicalClaims from "../../docs/data/cci-cms-lecanemab-fua-audit.json";
import singapore from "../../docs/data/cci-local-2026-singapore-case.json";
import london from "../../docs/data/cci-local-2026-london-case.json";
import helsinki from "../../docs/data/cci-local-2026-helsinki-case.json";
import zurich from "../../docs/data/cci-local-2026-zurich-case.json";
import gaza from "../../docs/data/cci-local-2026-gaza-case.json";
import tokyo from "../../docs/data/cci-local-2026-tokyo-case.json";
import washington from "../../docs/data/cci-local-2026-washington-case.json";
import newYork from "../../docs/data/cci-local-2026-new-york-case.json";
import paris from "../../docs/data/cci-local-2026-paris-case.json";
import sanJose from "../../docs/data/cci-local-2026-san-jose-case.json";
import losAngeles from "../../docs/data/cci-local-2026-los-angeles-case.json";
import osakaKyoto from "../../docs/data/cci-local-2026-osaka-kyoto-case.json";
import rankAudit from "../../docs/data/cci-local-2026-rank-audit.json";
import { cciCopy } from "@/cci/copy";
import { DIMENSIONS } from "@/cci/model";

interface Props {
  currentLang: "en" | "zh";
}

const { currentLang } = Astro.props;
const zh = currentLang === "zh";
const n = (value: number) => value.toLocaleString(zh ? "zh-CN" : "en-GB");
const counts = coverage.dimensionStatusCounts;
const legal = coverage.legalMobility.statusCounts;
const cases = [
  singapore,
  london,
  helsinki,
  zurich,
  gaza,
  tokyo,
  washington,
  newYork,
  paris,
  sanJose,
  losAngeles,
  osakaKyoto,
];
const screening = coverage.local2026Screening;
if (
  clinicalClaims.candidateCount !== coverage.candidateCount ||
  clinicalClaims.status !== "registered_claims_address_signal_not_local_delivery_or_scores"
) {
  throw new Error("Clinical claims address audit disagrees with the candidate scope");
}
if (
  rankAudit.candidateCount !== coverage.candidateCount ||
  rankAudit.conditionalCaseCount !== cases.length ||
  rankAudit.status !== "arithmetic_identifiability_audit_not_ranking" ||
  rankAudit.outsideFrameReview.manifestSha256 !== coverage.outsideFrameReview.manifestSha256 ||
  rankAudit.outsideFrameReview.globalRankingEligible !== false
) {
  throw new Error("Rank identifiability audit disagrees with the current candidate scope");
}
if (
  currentViolence.candidateCount !== coverage.candidateCount ||
  currentViolence.status !== "preliminary_violence_review_not_gss_scores" ||
  currentViolence.publicationBeforeCutoffVerified !== false
) {
  throw new Error("Preliminary violence review disagrees with current scope or publication status");
}
const fixedPositionCases = rankAudit.scenarios.fixed_conditional_centers.caseResults;
const helsinkiPosition = fixedPositionCases.find(c => c.efua_id === String(helsinki.candidateId));
if (!helsinkiPosition) throw new Error("Helsinki calibration is missing from the position audit");
if (
  cases.length !== screening.conditionalCaseCount ||
  cases.filter(c => c.expectedConditionalTotal !== null).length !==
    screening.completeConditionalCaseCount ||
  cases.filter(c => c.expectedConditionalTotal === null).length !== screening.partialCaseCount ||
  rankAudit.completeConditionalCaseCount !== screening.completeConditionalCaseCount ||
  rankAudit.partialCaseCount !== screening.partialCaseCount
) {
  throw new Error("Local calibration case count disagrees with the global matrix");
}
if (authorships.records !== works.records || authorships.files !== works.files) {
  throw new Error("Authorship inventory disagrees with the frozen work inventory");
}
if (
  affiliations.status !== "complete_2025_affiliation_diagnostics_not_city_output" ||
  affiliations.counts.records !== works.records ||
  affiliations.authorshipManifestSha256 !== authorships.manifestSha256
) {
  throw new Error("Affiliation diagnostics disagree with the verified authorship inventory");
}
const rows = [
  [
    "PCS",
    zh
      ? `${n(counts.PCS.partial_seismic_hazard_model)} 个候选有部分地震危险模型；尚缺其他自然风险与防护证据。`
      : `${n(counts.PCS.partial_seismic_hazard_model)} candidates have partial seismic hazard evidence; other hazards and protection remain unresolved.`,
  ],
  [
    "GSS",
    zh
      ? `${n(counts.GSS.partial_event_history)} 个候选关联到历史冲突事件；没有匹配事件不等于安全。`
      : `${n(counts.GSS.partial_event_history)} candidates have assigned historical conflict events; no matched event does not establish safety.`,
  ],
  [
    "ISR",
    zh
      ? `${n(counts.ISR.country_context_only)} 个候选有国家治理背景；尚不能据此区分城市。`
      : `${n(counts.ISR.country_context_only)} candidates have national governance context; this does not distinguish cities.`,
  ],
  [
    "RES",
    zh
      ? `${n(counts.RES.country_urban_water_context_only)} 个候选有国家城市人口饮用水背景；尚不是本地供给可靠性。`
      : `${n(counts.RES.country_urban_water_context_only)} candidates have national urban drinking-water context; this is not local supply reliability.`,
  ],
  [
    "MED",
    zh
      ? `${n(counts.MED.partial_access_model)} 个候选有部分医疗通达模型；尚不能代表质量、资格、费用或连续性。`
      : `${n(counts.MED.partial_access_model)} candidates have partial healthcare access models; these do not establish quality, eligibility, cost or continuity.`,
  ],
  [
    "LON",
    zh
      ? `${n(counts.LON.partial_claims_registered_address_signal)} 个功能区有 2024 年单药 Medicare FFS 理赔提供者登记地址信号：全国 ${n(clinicalClaims.recordCount)} 条公开记录统一定位，${n(clinicalClaims.mappingStatusCounts.exact_registered_address_signal)} 条精确地址记录唯一落入候选范围；非精确、未匹配、多解及界外结果全部保留。登记地址来自次年末，不是治疗地点或患者住所；计费单位不是输液次数，也不跨提供者累加成去重病人数。美国 ${n(clinicalClaims.coverageStatusCounts.no_exact_signal_not_no_adoption)} 个无精确信号，其他国家 ${n(clinicalClaims.coverageStatusCounts.outside_payer_frame_not_no_adoption)} 个不在该医保范围内，两者均不等于没有服务。仍须核验当地交付、适当监测、2026 延续及居民资格和负担，信号不自动给 LON 分数。`
      : `${n(counts.LON.partial_claims_registered_address_signal)} areas have registered-provider-address signals from 2024 single-drug Medicare FFS claims. All ${n(clinicalClaims.recordCount)} published records were geocoded uniformly; ${n(clinicalClaims.mappingStatusCounts.exact_registered_address_signal)} exact address records intersect one candidate area. Non-exact, unmatched, tied and outside-frame results remain. Next-year-end registered addresses are not treatment sites or patient homes; billing units are not infusions, and beneficiary counts are not deduplicated across providers. ${n(clinicalClaims.coverageStatusCounts.no_exact_signal_not_no_adoption)} US candidates lack an exact signal; ${n(clinicalClaims.coverageStatusCounts.outside_payer_frame_not_no_adoption)} in other countries are outside this payer frame. Neither establishes absent service. Local delivery, appropriate monitoring, 2026 continuity, resident eligibility and affordability still require review; signals grant no automatic LON score.`,
  ],
  [
    "TEC",
    zh
      ? `${n(counts.TEC.partial_network_samples)} 个候选有 2026 年第三季度网络测速样本，${n(counts.TEC.network_samples_missing)} 个缺少样本；样本存在选择与边界差异，尚不代表居民覆盖、科研、产业或技术普及。另已核验 ${n(institutions.recordCount)} 条科研机构目录记录，以及 ${n(works.records)} 条 2025 年 OpenAlex 记录的 ID 唯一性。后者包含数据集等类型，并非全部为论文；ID 唯一也不代表同一成果的不同版本已去重。已完成全部 ${n(authorships.files)} 个分区的作者单位投影；名单长度一致不证明原始单位完整。全量目录地点诊断已完成，涉及 ${n(affiliations.counts.authorships)} 条作者记录，其中 ${n(affiliations.counts.multiple_directory_fuas)} 条涉及多个目录功能区；歧义标记可重叠。实际研究地点、版本去重与贡献分摊仍未完成，未形成知识产出分数。`
      : `${n(counts.TEC.partial_network_samples)} candidates have Q3 2026 network test samples; ${n(counts.TEC.network_samples_missing)} lack samples. Selection and boundary effects remain; these do not establish resident coverage, research, industry or technology adoption. A further ${n(institutions.recordCount)} research institution directory records have been verified, alongside ID uniqueness for ${n(works.records)} OpenAlex records from 2025. These include datasets and other types, not just papers; unique IDs do not establish deduplication of versions of the same work. Authorship projections are complete for all ${n(authorships.files)} partitions; matching list lengths do not prove original affiliation completeness. Full directory-location diagnostics are complete for ${n(affiliations.counts.authorships)} authorship records, including ${n(affiliations.counts.multiple_directory_fuas)} involving multiple directory areas; ambiguity flags overlap. Actual research sites, version deduplication and credit allocation remain unresolved; no knowledge-output scores have been produced.`,
  ],
  [
    "OPT",
    zh
      ? `${n(counts.OPT.airport_directory_points_only)} 个候选内有机场目录坐标点，其中 ${n(airports.candidatesWithScheduledNonclosedPoints)} 个有定期服务且非关闭标记；目录不证明实际运营或居民可用，区外机场亦可能提供服务。另有 ${n(legal.conditional_legal_path_under_citizenship_assumption)} 个功能区在本国公民假设下有已审查的德国或法国法律条件，包括附条件居留权和八国公民赴德国境内申请程序；申请不是已获居留或工作权，就业、年龄、资源及医保要求仍保留；${n(legal.no_reviewed_path_not_no_right)} 个资格待查，不等于无权迁移。居住不证明国籍，合法路径不证明负担得起或危机可用；仍未形成完整 OPT 分数。`
      : `${n(counts.OPT.airport_directory_points_only)} candidates contain airport directory points; ${n(airports.candidatesWithScheduledNonclosedPoints)} have scheduled-service and nonclosed flags. A directory does not establish operations or resident access; outside airports may also serve residents. Separately, ${n(legal.conditional_legal_path_under_citizenship_assumption)} functional areas have reviewed German or French legal conditions under the local-citizenship assumption: conditional residence rights and an onshore application procedure for eight nationalities are distinct. Application is not approved residence or work; employment, age, resources and insurance conditions remain. ${n(legal.no_reviewed_path_not_no_right)} remain unreviewed, which does not mean denial. Residence does not establish citizenship; legal paths do not establish affordability or crisis operation. No complete OPT score follows.`,
  ],
] as const;
---

<section id="global-research" class="cci-section" aria-labelledby="global-research-title">
  <div class="cci-section-heading">
    <h2 id="global-research-title">
      {zh ? "全球 Top 32 研究进展" : "Global Top 32 research progress"}
    </h2>
    <p>
      <time datetime="2026-10-12">2026-10-12</time> · {
        zh
          ? "独立研究进度，不属于上方所选历史发布。全球 Top 32 尚未确定。"
          : "Separate research status, not part of the historical release selected above. A global Top 32 has not been established."
      }
    </p>
    <p>
      {
        zh
          ? `已登记 ${n(coverage.candidateCount)} 个功能城市区；${n(coverage.scoreStatusCounts.not_computed_under_global_protocol)} 个仍未完成全球统一规则下的完整评分。以下数量表示局部证据关联，不是合格城市数或完成率。`
          : `${n(coverage.candidateCount)} functional urban areas are registered; ${n(coverage.scoreStatusCounts.not_computed_under_global_protocol)} still lack complete assessments under a common global protocol. Counts below describe partial evidence links, not qualified cities or completion rates.`
      }
    </p>
    <p>
      {
        zh
          ? `UCDB R2024A 有 ${n(boundaries.centreOverlapCounts.no_overlap)} 个中心与旧功能区无交集；WUP 2025 的 ${n(wup.urbanCentres)} 个中心中有 ${n(wup.centreOverlapCounts.no_overlap)} 个无交集，其中 ${n(wup.wupCentresOutsideFuaAndUcdb)} 个也与 UCDB 无交集。两套来源的数量不能直接相加，边界迁移仍未解决。未收录、未匹配或资料缺失均不代表表现较差。`
          : `${n(boundaries.centreOverlapCounts.no_overlap)} UCDB R2024A centres do not overlap the older functional areas. Of ${n(wup.urbanCentres)} WUP 2025 centres, ${n(wup.centreOverlapCounts.no_overlap)} have no such overlap, including ${n(wup.wupCentresOutsideFuaAndUcdb)} that also do not overlap UCDB. Counts from the two sources cannot be added together; boundary migration remains unresolved. Omission, unmatched boundaries and missing data are not negative assessments.`
      }
    </p>
    <p>
      {
        zh
          ? `旧候选范围之外的 ${n(coverage.outsideFrameReview.recordCount)} 条未匹配中心记录已逐条保留，按跨来源交集组成 ${n(coverage.outsideFrameReview.reviewGroupCount)} 个边界复核组，其中 ${n(coverage.outsideFrameReview.groupsWithIndirectFuaLink)} 组存在间接旧 FUA 联系。这些是记录与复核组数量，不是去重城市数；间接联系不证明居民已被覆盖，也不继承分数。其八维与总分均未定，当前名次演算仍只限于旧 ${n(coverage.candidateCount)} 个功能区。范围缺口已接入资格检查，尚不能发布全球 Top 32。`
          : `All ${n(coverage.outsideFrameReview.recordCount)} unmatched centre records outside the old frame are retained in ${n(coverage.outsideFrameReview.reviewGroupCount)} boundary-review groups based on cross-source overlap; ${n(coverage.outsideFrameReview.groupsWithIndirectFuaLink)} groups have indirect links to old FUAs. These are record and review-group counts, not deduplicated city counts. Indirect links establish neither resident coverage nor inherited scores. All eight dimensions and totals remain unresolved; position arithmetic still covers only the older ${n(coverage.candidateCount)} functional areas. The scope gap is now included in eligibility checks; a global Top 32 cannot yet be published.`
      }
      {" "}
      <a
        href="https://github.com/realmorrisliu/realmorrisliu.com/blob/main/docs/cci-unmatched-centre-review.md"
        >{zh ? "查看未匹配中心逐条登记" : "Review every unmatched centre record"}</a
      >
    </p>
    <p>
      {
        zh
          ? "后续分别评价当地普通居民与跨国迁居者，沿用八维权重，各自审查入围名单，不合成单一榜单。跨国视角的基准人物参数仍待明确；当前发布未应用这两种视角。"
          : "Future assessments will distinguish ordinary local residents from international movers, retaining the eight weights and reviewing each shortlist separately. The mover profile remains unspecified; neither perspective has been applied to the current release."
      }
    </p>
  </div>
  <div id="local-calibration">
    <h3>{zh ? "当地居民评分校准" : "Local-resident scoring calibration"}</h3>
    <p>
      {
        zh
          ? `口径为 2026 年、本国公民、通常长期居住、当地中位收入和通常医保；证据截止 2026-10-10。${n(cases.length)} 份案例逐项审阅了八维及全部 31 个子支柱，其中 ${n(screening.completeConditionalCaseCount)} 份有完整条件性中心、${n(screening.partialCaseCount)} 份仅有部分维度判断。部分判断依赖明确假设，不表示每项均有充分测量；“—”表示未定，不能填零或生成总分。后续复核另记实际查阅日期。`
          : `These cases assess local citizens who usually reside in the city, at median local income and with usual healthcare coverage, in 2026. The evidence cutoff is 10 October 2026. All ${n(cases.length)} reviews cover eight dimensions and 31 subpillars: ${n(screening.completeConditionalCaseCount)} with complete conditional centres and ${n(screening.partialCaseCount)} with only partial judgments. Explicit assumptions do not establish complete measurements. “—” means unresolved, with no zero imputation or total centre. Subsequent checks record actual retrieval dates.`
      }
    </p>
    <div
      class="cci-table-scroll"
      tabindex="0"
      aria-label={zh ? "条件性评分案例" : "Conditional scoring cases"}
    >
      <table>
        <caption
          >{
            zh
              ? "条件性成绩单 · 用于校准，不是排名"
              : "Conditional scorecards · calibration, not a ranking"
          }</caption
        >
        <thead>
          <tr>
            <th scope="col">{zh ? "维度／原权重" : "Dimension / original weight"}</th>
            <th scope="col">{zh ? "新加坡" : "Singapore"}</th>
            <th scope="col">{zh ? "伦敦" : "London"}</th>
            <th scope="col">{zh ? "赫尔辛基" : "Helsinki"}</th>
            <th scope="col">{zh ? "苏黎世" : "Zurich"}</th>
            <th scope="col">{zh ? "加沙功能区" : "Gaza functional area"}</th>
            <th scope="col">{zh ? "东京功能区" : "Tokyo functional area"}</th>
            <th scope="col">{zh ? "华盛顿功能区" : "Washington functional area"}</th>
            <th scope="col">{zh ? "纽约功能区" : "New York functional area"}</th>
            <th scope="col">{zh ? "巴黎功能区" : "Paris functional area"}</th>
            <th scope="col">{zh ? "源名 San Jose 的功能区" : "Source-named San Jose FUA"}</th>
          </tr>
        </thead>
        <tbody>
          {
            DIMENSIONS.map(dimension => (
              <tr>
                <th scope="row">
                  {dimension.id} · {cciCopy[currentLang].dimensions[dimension.id].name} ·{" "}
                  {dimension.weight}%
                </th>
                {cases.map(city => (
                  <td>{city.dimensions.find(d => d.id === dimension.id)?.score ?? "—"}</td>
                ))}
              </tr>
            ))
          }
          <tr>
            <th scope="row">{zh ? "条件性总分" : "Conditional total"}</th>
            {cases.map(city => <td>{city.expectedConditionalTotal ?? "—"}</td>)}
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      {
        zh
          ? "新加坡与伦敦同为 58，不证明能力相等或稳定并列。医疗等待不能仅因超出行政目标就自动取 40；科研强不能代替居民扩散；长期迁居权不能覆盖交通、资金及通信的全部退出条件。长寿路径的代表性假设最需挑战：若不接受该假设，LON 应保持未定，总分中心也应为空。"
          : "Singapore and London both have conditional totals of 58; this does not establish equal capability or a stable tie. Missing an administrative waiting target does not automatically imply MED 40; strong research does not establish resident diffusion, and residence rights do not cover every transport, financial or communication condition. Longevity pathway representativeness is the weakest assumption: rejecting it leaves LON unresolved and removes the total's central estimate."
      }
    </p>
    <p>
      {
        zh
          ? "新加坡高档再检验已核验截止日前 IMDA 2026 原始报告：企业采用与工人实际使用、受益分别判读，培训差异不自动扣分，较高采用率也不自动支持 TEC 80。MOH 明确未追踪所询问的费用相关延迟／放弃治疗数据；这是已确认的测量缺口，不是未满足需求为零或普遍医疗失效。TEC 与 MED 仍依赖必要假设；仅 TEC 未定则总分无中心、数学域为 52—62，两项同时未定则为 43—68。"
          : "Singapore's high-tier review verifies the pre-cutoff IMDA 2026 report. Enterprise adoption, worker use and reported benefits have different denominators; training differences do not automatically lower a score, and high adoption does not establish TEC 80. MOH confirms it does not track the requested cost-related delayed or forgone-care data. This is a measurement gap, not zero unmet need or widespread care failure. TEC and MED still require necessary assumptions: unresolved TEC removes the total's centre, giving a mathematical domain of 52–62; unresolved MED and TEC give 43–68."
      }
    </p>
    <p>
      {
        zh
          ? "苏黎世条件性总分为 58。DO-HEALTH 的主要临床终点与后续生物时钟分析分开判读，并保留跌倒分析的可能益处；拒绝路径代表性假设则 LON 未定、无总分中心。铁路、航空和迁居资格支持退出路径，但移动紧急呼叫备电要求到 2031 年才落实，不能计作当前 OPT 80。历史心外科质量反证也不自动变成 2026 当前失效率。现有案例仍未建立真实 80 分锚点或跨研究者一致性。"
          : "Zurich's conditional total is 58. DO-HEALTH's primary clinical outcomes are distinguished from later clock analysis, while possible benefit in the fall analysis is retained. Rejecting pathway representativeness leaves LON unresolved and removes the total's centre. Rail, aviation and residence rights support exit channels, but mobile emergency-call backup requirements apply from 2031; they do not establish current OPT 80. Historical cardiac-surgery failures are not 2026 failure rates. Current cases still establish neither a verified real-world 80 anchor nor inter-reviewer consistency."
      }
    </p>
    <p>
      {
        zh
          ? "苏黎世 GSS 补入 2026 年温特图尔站区袭击的三名伤者、实际警务与救援，以及随后公布的极端主义判断。两份通报对应同一事件；站前地址与周边 2 公里落在冻结功能区内，但它不是精确案发点，定位延续及全区适用仍是假设。GSS 保持条件性 60；仅在新依据支持 80 时总分才为 61。撤回 GSS 假设则无中心、数学域 49—64，与 LON 一起撤回为 45—70。单次事件不自动降档，一般犯罪记录也不等于死亡人数。"
          : "Zurich's GSS review now includes three people injured in the 2026 Winterthur station-area attack, police and rescue action, and the later extremism assessment. Both notices concern one event. A station-front address and its surrounding 2 km lie within the frozen FUA, but this is not the exact attack location; location continuity and whole-FUA applicability remain assumptions. GSS stays conditionally 60. Only new support for 80 would raise the total to 61. Withdrawing GSS removes the centre and gives a mathematical domain of 49–64; withdrawing LON too gives 45–70. One event does not automatically lower the score, and general offence counts are not deaths."
      }
    </p>
    <p>
      {
        zh
          ? "赫尔辛基条件性总分为 60。FINGER 有两年人体认知试验结果，但当前免费记忆小组不等于完整干预已交付；LON 60 依赖有限转化路径的连接假设，拒绝该假设则无总分中心。仅在新的必要治疗阻断依据支持 MED 40 时，总分变为 57，低于另外两城当前的 58。这说明 2 分差不足以证明确定优劣。实际数字服务采用也尚不足以支持 TEC 80。"
          : "Helsinki's conditional total is 60. FINGER has a two-year human cognitive result, but current free memory groups do not establish delivery of the complete intervention. LON 60 depends on a limited translation-pathway assumption; rejecting it removes the total's centre. Only if new evidence of blocked necessary care supports MED 40 does the total become 57, below the other two cases' current 58. A two-point gap does not establish superiority. Actual digital-service adoption also falls short of the evidence needed for TEC 80."
      }
    </p>
