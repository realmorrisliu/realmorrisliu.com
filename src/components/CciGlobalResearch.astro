import tokyo from "../../docs/data/cci-local-2026-tokyo-case.json";
import washington from "../../docs/data/cci-local-2026-washington-case.json";
import newYork from "../../docs/data/cci-local-2026-new-york-case.json";
import paris from "../../docs/data/cci-local-2026-paris-case.json";
import sanJose from "../../docs/data/cci-local-2026-san-jose-case.json";
import losAngeles from "../../docs/data/cci-local-2026-los-angeles-case.json";
import osakaKyoto from "../../docs/data/cci-local-2026-osaka-kyoto-case.json";
import boston from "../../docs/data/cci-local-2026-boston-case.json";
import seoul from "../../docs/data/cci-local-2026-seoul-case.json";
import lisbon from "../../docs/data/cci-local-2026-lisbon-case.json";
import chicago from "../../docs/data/cci-local-2026-chicago-case.json";
import prague from "../../docs/data/cci-local-2026-prague-case.json";
import beijing from "../../docs/data/cci-local-2026-beijing-case.json";
import shanghai from "../../docs/data/cci-local-2026-shanghai-case.json";
import jakarta from "../../docs/data/cci-local-2026-jakarta-case.json";
import rankAudit from "../../docs/data/cci-local-2026-rank-audit.json";
import { cciCopy } from "@/cci/copy";
import { DIMENSIONS } from "@/cci/model";

interface Props {
  currentLang: "en" | "zh";
}

const { currentLang } = Astro.props;
const zh = currentLang === "zh";
const n = (value: number) => value.toLocaleString(zh ? "zh-CN" : "en-GB");
const counts = coverage.dimensionStatusCounts;
const legal = coverage.legalMobility.statusCounts;
const cases = [
  singapore,
  london,
  helsinki,
  zurich,
  gaza,
  tokyo,
  washington,
  newYork,
  paris,
  sanJose,
  losAngeles,
  osakaKyoto,
  boston,
  seoul,
  lisbon,
  chicago,
  prague,
  beijing,
  shanghai,
  jakarta,
];
const caseNamesZh: Record<number, string> = {
  [jakarta.candidateId]: "雅加达功能区",
  [singapore.candidateId]: "新加坡",
  [london.candidateId]: "伦敦",
  [helsinki.candidateId]: "赫尔辛基",
  [zurich.candidateId]: "苏黎世",
  [gaza.candidateId]: "加沙功能区",
  [tokyo.candidateId]: "东京功能区",
  [washington.candidateId]: "华盛顿功能区",
  [newYork.candidateId]: "纽约功能区",
  [paris.candidateId]: "巴黎功能区",
  [sanJose.candidateId]: "源名 San Jose 的功能区",
  [losAngeles.candidateId]: "洛杉矶功能区",
  [osakaKyoto.candidateId]: "大阪—京都功能区",
  [boston.candidateId]: "波士顿功能区",
  [seoul.candidateId]: "首尔功能区",
  [lisbon.candidateId]: "里斯本功能区",
  [chicago.candidateId]: "芝加哥功能区",
  [prague.candidateId]: "布拉格功能区",
  [beijing.candidateId]: "北京功能区",
  [shanghai.candidateId]: "上海功能区",
};
const screening = coverage.local2026Screening;
if (
  recordPresence.candidateCount !== coverage.candidateCount ||
  recordPresence.status !== "complete_2025_directory_record_associations_not_output_or_scores" ||
  recordPresence.distinctRecordsWithAssociation !==
    affiliations.counts.works_with_any_single_consistent_directory_fua
) {
  throw new Error("Research directory associations disagree with the full candidate scope");
}
if (
  clinicalClaims.candidateCount !== coverage.candidateCount ||
  clinicalClaims.status !== "registered_claims_address_signal_not_local_delivery_or_scores"
) {
  throw new Error("Clinical claims address audit disagrees with the candidate scope");
}
if (
  rankAudit.candidateCount !== coverage.candidateCount ||
  rankAudit.conditionalCaseCount !== cases.length ||
  rankAudit.status !== "arithmetic_identifiability_audit_not_ranking" ||
  rankAudit.outsideFrameReview.manifestSha256 !== coverage.outsideFrameReview.manifestSha256 ||
  rankAudit.outsideFrameReview.globalRankingEligible !== false
) {
  throw new Error("Rank identifiability audit disagrees with the current candidate scope");
}
if (
  currentViolence.candidateCount !== coverage.candidateCount ||
  currentViolence.status !== "preliminary_violence_review_not_gss_scores" ||
  currentViolence.publicationBeforeCutoffVerified !== false
) {
  throw new Error("Preliminary violence review disagrees with current scope or publication status");
}
const fixedPositionCases = rankAudit.scenarios.fixed_conditional_centers.caseResults;
const helsinkiPosition = fixedPositionCases.find(c => c.efua_id === String(helsinki.candidateId));
if (!helsinkiPosition) throw new Error("Helsinki calibration is missing from the position audit");
if (
  cases.length !== screening.conditionalCaseCount ||
  cases.filter(c => c.expectedConditionalTotal !== null).length !==
    screening.completeConditionalCaseCount ||
  cases.filter(c => c.expectedConditionalTotal === null).length !== screening.partialCaseCount ||
  rankAudit.completeConditionalCaseCount !== screening.completeConditionalCaseCount ||
  rankAudit.partialCaseCount !== screening.partialCaseCount
) {
  throw new Error("Local calibration case count disagrees with the global matrix");
}
if (authorships.records !== works.records || authorships.files !== works.files) {
  throw new Error("Authorship inventory disagrees with the frozen work inventory");
}
if (
  affiliations.status !== "complete_2025_affiliation_diagnostics_not_city_output" ||
  affiliations.counts.records !== works.records ||
  affiliations.authorshipManifestSha256 !== authorships.manifestSha256
) {
  throw new Error("Affiliation diagnostics disagree with the verified authorship inventory");
}
const rows = [
  [
    "PCS",
    zh
      ? `${n(counts.PCS.partial_seismic_hazard_model)} 个候选有部分地震危险模型；尚缺其他自然风险与防护证据。`
      : `${n(counts.PCS.partial_seismic_hazard_model)} candidates have partial seismic hazard evidence; other hazards and protection remain unresolved.`,
  ],
  [
    "GSS",
    zh
      ? `${n(counts.GSS.partial_event_history)} 个候选关联到历史冲突事件；没有匹配事件不等于安全。`
      : `${n(counts.GSS.partial_event_history)} candidates have assigned historical conflict events; no matched event does not establish safety.`,
  ],
  [
    "ISR",
    zh
      ? `${n(counts.ISR.country_context_only)} 个候选有国家治理背景；尚不能据此区分城市。`
      : `${n(counts.ISR.country_context_only)} candidates have national governance context; this does not distinguish cities.`,
  ],
  [
    "RES",
    zh
      ? `${n(counts.RES.country_urban_water_context_only)} 个候选有国家城市人口饮用水背景；尚不是本地供给可靠性。`
      : `${n(counts.RES.country_urban_water_context_only)} candidates have national urban drinking-water context; this is not local supply reliability.`,
  ],
  [
    "MED",
    zh
      ? `${n(counts.MED.partial_access_model)} 个候选有部分医疗通达模型；尚不能代表质量、资格、费用或连续性。`
      : `${n(counts.MED.partial_access_model)} candidates have partial healthcare access models; these do not establish quality, eligibility, cost or continuity.`,
  ],
  [
    "LON",
    zh
      ? `${n(counts.LON.partial_claims_registered_address_signal)} 个功能区有 2024 年单药 Medicare FFS 理赔提供者登记地址信号：全国 ${n(clinicalClaims.recordCount)} 条公开记录统一定位，${n(clinicalClaims.mappingStatusCounts.exact_registered_address_signal)} 条精确地址记录唯一落入候选范围；非精确、未匹配、多解及界外结果全部保留。登记地址来自次年末，不是治疗地点或患者住所；计费单位不是输液次数，也不跨提供者累加成去重病人数。美国 ${n(clinicalClaims.coverageStatusCounts.no_exact_signal_not_no_adoption)} 个无精确信号，其他国家 ${n(clinicalClaims.coverageStatusCounts.outside_payer_frame_not_no_adoption)} 个不在该医保范围内，两者均不等于没有服务。仍须核验当地交付、适当监测、2026 延续及居民资格和负担，信号不自动给 LON 分数。`
      : `${n(counts.LON.partial_claims_registered_address_signal)} areas have registered-provider-address signals from 2024 single-drug Medicare FFS claims. All ${n(clinicalClaims.recordCount)} published records were geocoded uniformly; ${n(clinicalClaims.mappingStatusCounts.exact_registered_address_signal)} exact address records intersect one candidate area. Non-exact, unmatched, tied and outside-frame results remain. Next-year-end registered addresses are not treatment sites or patient homes; billing units are not infusions, and beneficiary counts are not deduplicated across providers. ${n(clinicalClaims.coverageStatusCounts.no_exact_signal_not_no_adoption)} US candidates lack an exact signal; ${n(clinicalClaims.coverageStatusCounts.outside_payer_frame_not_no_adoption)} in other countries are outside this payer frame. Neither establishes absent service. Local delivery, appropriate monitoring, 2026 continuity, resident eligibility and affordability still require review; signals grant no automatic LON score.`,
  ],
  [
    "TEC",
    zh
      ? `${n(counts.TEC.partial_network_samples)} 个候选有 2026 年第三季度网络测速样本，${n(counts.TEC.network_samples_missing)} 个缺少样本；样本存在选择与边界差异，尚不代表居民覆盖、科研、产业或技术普及。另已核验 ${n(institutions.recordCount)} 条科研机构目录记录，以及 ${n(works.records)} 条 2025 年 OpenAlex 记录的 ID 唯一性。后者包含数据集等类型，并非全部为论文；ID 唯一也不代表同一成果的不同版本已去重。已完成全部 ${n(authorships.files)} 个分区的作者单位投影；名单长度一致不证明原始单位完整。全量目录地点诊断已完成，涉及 ${n(affiliations.counts.authorships)} 条作者记录，其中 ${n(affiliations.counts.multiple_directory_fuas)} 条涉及多个目录功能区；歧义标记可重叠。已按相同规则汇总全部 ${n(recordPresence.candidateCount)} 个候选的目录关联记录，${n(recordPresence.candidatesWithAssociation)} 个有合格关联；同城作者不重复，作品类型、语料和撤稿状态分开保留。零关联不等于没有科研；跨城合作记录不能相加当作全球唯一成果。实际研究地点、版本去重与贡献分摊仍未完成，未形成知识产出分数。`
      : `${n(counts.TEC.partial_network_samples)} candidates have Q3 2026 network test samples; ${n(counts.TEC.network_samples_missing)} lack samples. Selection and boundary effects remain; these do not establish resident coverage, research, industry or technology adoption. A further ${n(institutions.recordCount)} research institution directory records have been verified, alongside ID uniqueness for ${n(works.records)} OpenAlex records from 2025. These include datasets and other types, not just papers; unique IDs do not establish deduplication of versions of the same work. Authorship projections are complete for all ${n(authorships.files)} partitions; matching list lengths do not prove original affiliation completeness. Full directory-location diagnostics are complete for ${n(affiliations.counts.authorships)} authorship records, including ${n(affiliations.counts.multiple_directory_fuas)} involving multiple directory areas; ambiguity flags overlap. The same rules now aggregate directory-associated records for all ${n(recordPresence.candidateCount)} candidates; ${n(recordPresence.candidatesWithAssociation)} have qualifying associations. Authors in the same area count once per work, with type, corpus and retraction status kept separate. Zero associations do not mean no research; cross-area coauthor counts cannot be summed as unique global works. Actual research sites, version deduplication and credit allocation remain unresolved; no knowledge-output scores have been produced.`,
  ],
  [
    "OPT",
    zh
      ? `${n(counts.OPT.airport_directory_points_only)} 个候选内有机场目录坐标点，其中 ${n(airports.candidatesWithScheduledNonclosedPoints)} 个有定期服务且非关闭标记；目录不证明实际运营或居民可用，区外机场亦可能提供服务。另有 ${n(legal.conditional_legal_path_under_citizenship_assumption)} 个功能区在本国公民假设下有已审查的德国或法国法律条件，包括附条件居留权、八国公民赴德国境内申请程序，以及中国／印尼公民合资格工作居留的通常入境前签证路径；申请不是已获居留或工作权，就业、年龄、资源及医保要求仍保留；${n(legal.no_reviewed_path_not_no_right)} 个资格待查，不等于无权迁移。居住不证明国籍，合法路径不证明负担得起或危机可用；仍未形成完整 OPT 分数。`
      : `${n(counts.OPT.airport_directory_points_only)} candidates contain airport directory points; ${n(airports.candidatesWithScheduledNonclosedPoints)} have scheduled-service and nonclosed flags. A directory does not establish operations or resident access; outside airports may also serve residents. Separately, ${n(legal.conditional_legal_path_under_citizenship_assumption)} functional areas have reviewed German or French legal conditions under the local-citizenship assumption: conditional residence rights, an onshore application procedure for eight nationalities, and the normally pre-entry national-visa route for eligible Chinese and Indonesian skilled workers are distinct. Application is not approved residence or work; employment, age, resources and insurance conditions remain. ${n(legal.no_reviewed_path_not_no_right)} remain unreviewed, which does not mean denial. Residence does not establish citizenship; legal paths do not establish affordability or crisis operation. No complete OPT score follows.`,
  ],
] as const;
const caseNotes: Record<number, string[]> = {
  [jakarta.candidateId]: [
    zh
      ? "雅加达 PCS／GSS／ISR／RES 条件性 40，MED／TEC／OPT 条件性 60，LON 未定；数学域 43—53，无总分中心。实际防护、救援、调查和服务与反复洪灾、侵害及恢复／水质约束共同判读。功能区跨 DKI、万丹和西爪哇；德波、茂物和勿加泗参考点在区内，行政总量和局部样本不当全区居民率。研究顺序来自全量目录关联，不是提名或得分。"
      : "Jakarta has conditional 40 judgments for PCS, GSS, ISR and RES, and 60 for MED, TEC and OPT. LON is unresolved: the mathematical domain is 43–53, without a total centre. Operating protection, rescue, investigation and care are read alongside repeated floods, coercive harms, recovery and water-quality constraints. The FUA spans DKI, Banten and West Java; Depok, Bogor and Bekasi references lie inside it. Administrative totals and local samples are not full-area resident rates. Global directory associations only determine research sequence.",
    zh
      ? "长寿原试验报 28 人／51 膝，与旧登记和部分表格存在未解释差异；主要比较不显著，品牌推出或生产质量认证不能补齐当前合规、支付及监护路径。饮水 495/978 是抽样合格数，不是全区安全水率；CT 270/287 与溶栓 76/76 是院内适用队列过程，不是居民结局。买汇每人每月 1 万美元是无需基础交易材料的门槛，超额合法路径保留。现有国际连接与雅加达网络节点修复另有原件；移民系统恢复不当通信恢复。必要假设拒绝即撤回相应维度，不授予排除或全球入围资格。"
      : "The longevity study reports 28 people and 51 knees, with unresolved registry and table differences and nonsignificant major comparisons. Brand launch or production-quality certification does not establish the current compliant, paid and monitored resident pathway. Water compliance of 495/978 is a sample count; CT 270/287 and thrombolysis 76/76 describe eligible hospital processes, not resident outcomes. USD10,000 per person per month is the no-underlying-document FX-buy threshold; lawful higher transactions remain possible. Existing international links and a repaired Jakarta network incident have separate sources; immigration-system recovery is not communications recovery. Rejecting necessary assumptions withdraws the corresponding judgment, without exclusion or global qualification.",
  ],
  [singapore.candidateId]: [
    zh
      ? "新加坡 TEC 复核为条件性 80：NRF 多机构实际转化、IMDA 企业／工人采用与居民数字使用、已完成辅助交易共同支持高档。不同分母不合并；技能和融资短板保留，若在缓解后仍构成重要限制，可重审 60。多生产者延续、通常居民广泛可用及空间／时点适用仍须假设，拒绝则 TEC 未定。MOH 明确未追踪所询问的费用相关延迟／放弃治疗数据；这是已确认的测量缺口，不是未满足需求为零或普遍医疗失效。TEC 与 MED 仍依赖必要假设；仅 TEC 未定则总分无中心、数学域为 52—62，两项同时未定则为 43—68。"
      : "Singapore's TEC is reassessed as a conditional 80: actual multi-institution translation, enterprise/worker adoption, resident digital use and completed assisted transactions jointly support the higher tier. Denominators remain separate. Skills and financing gaps are retained; material constraints after mitigation could support 60. Continuing multi-producer capacity, broad ordinary-resident usability and spatial/time applicability remain assumptions; rejecting them leaves TEC unknown. MOH confirms it does not track the requested cost-related delayed or forgone-care data. This is a measurement gap, not zero unmet need or widespread care failure. TEC and MED still require necessary assumptions: unresolved TEC removes the total's centre, giving a mathematical domain of 52–62; unresolved MED and TEC give 43–68.",
  ],
  [london.candidateId]: [
    zh
      ? "在伦敦 MED 40、OPT 80 的条件情景下，原权重总分为 57；仅将 MED 的 5 个权重点移至 OPT，就变为 59，仍低于新加坡该权重下的 60；若新加坡采用 TEC 60 的替代判断，总分为 58，该情景才翻转。这是敏感性演算，不是已经取得的新证据，正式权重不变。"
      : "In the conditional London scenario MED 40 / OPT 80, the original-weight total is 57. Moving five weight points from MED to OPT yields 59, still below Singapore's 60; Singapore's alternative TEC 60 judgment instead yields 58 and allows that scenario to reverse the order. This is a sensitivity exercise, not newly established evidence; official weights remain unchanged.",
  ],
  [helsinki.candidateId]: [
    zh
      ? "赫尔辛基 TEC 复核为条件性 80，总分 62。两校持续产出、实际技术转移与长期产业吸收，以及首都地区多类居民实际使用支持高档；融资压力和全国高龄使用差异保留，市服务响应与辅助措施不是全群体覆盖证明。空间、延续及普通居民通常可用仍须假设，拒绝 TEC 假设则无中心、数学域 54—64；若重要瓶颈在缓解后仍成立，TEC 60 情景总分为 60。MED 40 有新阻断依据才采用，该情景为 59；小分差不证明优劣或入围。FINGER 人体结果不等于完整干预当前交付，LON 连接假设仍可撤回。"
      : "Helsinki's TEC is reassessed as conditional 80, giving a total of 62. Sustained output from two universities, actual technology transfers, long-term industry absorption and multiple kinds of capital-region resident use support the higher tier. Financing pressures and national older-age usage gaps remain counterevidence; municipal response and assistance do not prove whole-group reach. Spatial applicability, continuity and ordinary usability remain assumptions. Rejecting TEC assumptions removes the centre, giving 54–64; material constraints after mitigation could support TEC 60 and a total of 60. Only new support for blocked necessary care justifies MED 40, yielding 59. Small gaps prove neither superiority nor qualification. FINGER's human result does not establish current delivery of its complete intervention; the LON pathway assumption remains reversible.",
  ],
  [zurich.candidateId]: [
    zh
      ? "苏黎世条件性总分为 58。DO-HEALTH 的主要临床终点与后续生物时钟分析分开判读，并保留跌倒分析的可能益处；拒绝路径代表性假设则 LON 未定、无总分中心。铁路、航空和迁居资格支持退出路径，但移动紧急呼叫备电要求到 2031 年才落实，不能计作当前 OPT 80。历史心外科质量反证也不自动变成 2026 当前失效率。新加坡／赫尔辛基／东京的条件性 TEC 80 不证明其他维度高档或跨研究者一致性。"
      : "Zurich's conditional total is 58. DO-HEALTH's primary clinical outcomes are distinguished from later clock analysis, while possible benefit in the fall analysis is retained. Rejecting pathway representativeness leaves LON unresolved and removes the total's centre. Rail, aviation and residence rights support exit channels, but mobile emergency-call backup requirements apply from 2031; they do not establish current OPT 80. Historical cardiac-surgery failures are not 2026 failure rates. Singapore's, Helsinki's and Tokyo's conditional TEC 80 judgments establish neither higher tiers elsewhere nor inter-reviewer consistency.",
    zh
      ? "苏黎世 GSS 补入 2026 年温特图尔站区袭击的三名伤者、实际警务与救援，以及随后公布的极端主义判断。两份通报对应同一事件；站前地址与周边 2 公里落在冻结功能区内，但它不是精确案发点，定位延续及全区适用仍是假设。GSS 保持条件性 60；仅在新依据支持 80 时总分才为 61。撤回 GSS 假设则无中心、数学域 49—64，与 LON 一起撤回为 45—70。单次事件不自动降档，一般犯罪记录也不等于死亡人数。"
      : "Zurich's GSS review now includes three people injured in the 2026 Winterthur station-area attack, police and rescue action, and the later extremism assessment. Both notices concern one event. A station-front address and its surrounding 2 km lie within the frozen FUA, but this is not the exact attack location; location continuity and whole-FUA applicability remain assumptions. GSS stays conditionally 60. Only new support for 80 would raise the total to 61. Withdrawing GSS removes the centre and gives a mathematical domain of 49–64; withdrawing LON too gives 45–70. One event does not automatically lower the score, and general offence counts are not deaths.",
  ],
  [gaza.candidateId]: [
    zh
      ? "加沙功能区由全候选历史信号确定调查优先级，再核验截止日前 WHO 与 OCHA 当前证据。PCS 条件性 40，GSS、RES、MED 各 20；ISR、LON、TEC、OPT 未定，无总分。正在运行的医院、援助和转运与严重约束一并判读；没有测速样本不记低分。固定四项判断后的数学域为 14—59，撤回 MED 假设则为 11—71，均不是可靠排除界限。地带范围的资料不能冒充加沙市实测；功能区适配仍未完成。"
