  recordPresence.candidateCount !== coverage.candidateCount ||
  recordPresence.status !== "complete_2025_directory_record_associations_not_output_or_scores" ||
  recordPresence.distinctRecordsWithAssociation !==
    affiliations.counts.works_with_any_single_consistent_directory_fua
