---
import { getCollection, type CollectionEntry, render } from "astro:content";
import BlogPost from "@layouts/BlogPost.astro";

export const prerender = true;
export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(post => !post.data.draft);
  const slugSet = new Set(posts.map(post => post.id.replace(/\.(md|mdx)$/, "")));

  return posts.map(post => {
    const slug = post.id.replace(/\.(md|mdx)$/, "");
    const isChineseSlug = slug.endsWith("-zh");
    const counterpartSlug = isChineseSlug ? slug.slice(0, -3) : `${slug}-zh`;
    const alternateLanguages = slugSet.has(counterpartSlug)
      ? [
          {
            lang: isChineseSlug ? "en" : "zh-CN",
            url: `https://realmorrisliu.com/thoughts/${counterpartSlug}`,
          },
        ]
      : [];

    return {
      params: { slug },
      props: { post, alternateLanguages },
    };
  });
}

type Props = {
  post: CollectionEntry<"blog">;
  alternateLanguages: { lang: string; url: string }[];
};

const { post, alternateLanguages } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  tags={post.data.tags}
  readingTime={post.data.readingTime}
  draft={post.data.draft}
  alternateLanguages={alternateLanguages}
>
  <Content />
</BlogPost>
